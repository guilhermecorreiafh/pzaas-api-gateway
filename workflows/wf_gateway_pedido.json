    },
    {
      "parameters": {
        "jsCode": "const pedido = $('gt_pedido').first().json.body;\nconst apiKey = $('gt_pedido').first().json.headers['x-api-key'];\n\n// valida a api-key\nif (apiKey !== 'turma2026') {\n  return [{ json: { _erro: true, erro: 'api_key_ausente_ou_invalida' } }];\n}\n\n// monta a tabela de precos a partir da resposta do Catalogo\nconst catalogo = $('http_catalogo').first().json;\nconst pizzas = catalogo.pizzas || [];\nconst precos = {};\nfor (const p of pizzas) {\n  precos[p.nome] = p.preco;\n}\n\nlet valor = 0;\nfor (const item of pedido.itens) {\n  const preco = precos[item.pizza];\n  if (preco === undefined) {\n    throw new Error(`Pizza sem preço no catálogo: ${item.pizza}`);\n  }\n  valor += preco * item.quantidade;\n}\n\nreturn [{\n  json: {\n    url_pagamento: \"http://localhost:5678/webhook/v1/mock/pagamento-a/cobranca\",\n    api_key: \"turma2026\",\n    payload: {\n      cliente_id: pedido.cliente_id,\n      token: pedido.token,\n      valor: Number(valor.toFixed(2)),\n      metodo_pagamento: pedido.metodo_pagamento,\n      itens: pedido.itens,\n      simular_erro: pedido.simular_erro\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        -16
      ],
      "id": "4221bfbb-342f-4522-ad8d-b6011f6fdfc4",
      "name": "calc_valor"
    },
