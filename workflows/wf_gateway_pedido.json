{
  "name": "wf_gateway_pedido",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const pedido = $('post_pedido').first().json.body;\n\n// monta a tabela de precos a partir da resposta do Catalogo\nconst catalogo = $('http_catalogo').first().json;\nconst pizzas = catalogo.pizzas || [];\nconst precos = {};\nfor (const p of pizzas) {\n  precos[p.nome] = p.preco;\n}\n\nlet valor = 0;\nfor (const item of pedido.itens) {\n  const preco = precos[item.pizza];\n  if (preco === undefined) {\n    // pizza fora do catalogo -> pedido invalido, sem derrubar o fluxo\n    return [{\n      json: {\n        _erro: true,\n        erro: \"pizza_sem_preco\",\n        motivo: `Pizza sem preço no catálogo: ${item.pizza}`\n      }\n    }];\n  }\n  valor += preco * item.quantidade;\n}\n\nreturn [{\n  json: {\n    _erro: false,\n    url_pagamento: \"https://dannneves.app.n8n.cloud/webhook/v1/pagamento\",\n    api_key: \"turma2026\",\n    payload: {\n      cliente_id: pedido.cliente_id,\n      token: pedido.token,\n      valor: Number(valor.toFixed(2)),\n      metodo_pagamento: pedido.metodo_pagamento,\n      itens: pedido.itens,\n      simular_erro: pedido.simular_erro\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -784,
        480
      ],
      "id": "eb03a336-49c4-4f6e-b7e3-ab4c6feb77db",
